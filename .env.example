# ---- Bosqich 1 (LLM'siz) uchun hech narsa shart emas. Hammasi ishlaydi. ----

# Umumiy
HAMROH_DB=./data/hamroh.db
HAMROH_TZ=Asia/Tashkent
HAMROH_CITY=Tashkent
HAMROH_CURRENCY=UZS
HAMROH_LANG=uz

# Tashqi manbalar (ixtiyoriy, kalitsiz ham ishlaydi)
HAMROH_OFFLINE=0                  # 1 => tarmoqqa umuman chiqmaydi
HAMROH_NEWS_FEEDS=                # vergul bilan qo'shimcha RSS manzillari

# ---- Bosqich 2 (LLM ulanadi) ----
HAMROH_LLM=rules                  # rules | local | anthropic

# local — o'z serveringizdagi model (Ollama / llama.cpp / vLLM / LM Studio)
HAMROH_LLM_URL=http://127.0.0.1:11434/v1
# HAMROH_LLM_MODEL=qwen3:14b
HAMROH_LLM_KEY=local

# anthropic — Claude API
ANTHROPIC_API_KEY=
# HAMROH_LLM_MODEL=claude-opus-5

# ---- Ovozli xabarlar (Whisper) ----
HAMROH_STT=off                    # off | local
HAMROH_STT_URL=http://127.0.0.1:8000/v1
HAMROH_STT_MODEL=Systran/faster-whisper-large-v3
HAMROH_STT_LANG=uz                # bo'sh qoldirilsa model tilni o'zi aniqlaydi
HAMROH_STT_KEY=local
# HAMROH_STT_HINT=                # tez-tez uchraydigan ismlar/atamalar, aniqlikni oshiradi

# ---- Ovozli javob (TTS) va ovozli buyruqlar ----
HAMROH_TTS=off                    # off | http | cmd
# http — OpenAI-mos /audio/speech (LocalAI, Speaches, openedai-speech)
HAMROH_TTS_URL=http://127.0.0.1:8000/v1
HAMROH_TTS_MODEL=tts-1
HAMROH_TTS_VOICE=alloy
HAMROH_TTS_FORMAT=mp3             # ogg bo'lsa Telegramga haqiqiy "voice message" ketadi
# cmd — istalgan dastur: {out} audio fayl yo'li, {text} matn (bo'lmasa stdin)
# HAMROH_TTS_CMD=piper -m uz.onnx -f {out}

HAMROH_VOICE_COMMANDS=0           # 1 => Telegram ovozli xabarlari buyruq sifatida bajariladi

# ---- Bosqich 3 (integratsiyalar) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Qo'shimcha ruxsat berilgan chat/user ID lar (vergul bilan).
# Bo'sh bo'lsa faqat TELEGRAM_CHAT_ID ruxsat oladi — ro'yxat butunlay bo'sh bo'lsa
# bot hech kimga javob bermaydi (ataylab: bot havolasi ochiq bo'ladi).
TELEGRAM_ALLOWED_IDS=
# Webhook rejimi uchun (long polling da kerak emas)
TELEGRAM_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ICS_URL=
YOUTUBE_API_KEY=
GOOGLE_ADS_CUSTOMER_ID=
INSTAGRAM_ACCESS_TOKEN=
